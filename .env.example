# Environment Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration (Defaults to local SQLite fallback if unset)
# For local SQLite:
DATABASE_URL=sqlite:///./drug_interaction.db
# For production PostgreSQL (e.g. Neon, Supabase, Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000
